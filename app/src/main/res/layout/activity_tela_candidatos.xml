<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E2E2E2"
    tools:context=".TelaCandidatos">

    <!-- Cabeçalho (Header Azul) -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fbInterrogacao4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.4"
        android:clickable="true"
        app:backgroundTint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvContainerList"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/interrogacao"
        app:tint="@color/black" />

    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="#203652"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Texto Centralizado -->

    <!-- Foto de Perfil Arredondada sobre o Header -->

    <ImageButton
        android:id="@+id/ibAcessibilidade2"
        android:layout_width="41dp"
        android:layout_height="43dp"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/headerBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.491"
        app:srcCompat="@drawable/acessib" />

    <ImageButton
        android:id="@+id/btThemeToggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Alternar Tema"
        android:padding="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/headerBackground"
        app:layout_constraintEnd_toStartOf="@+id/cvFotoPerfil"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/headerBackground"
        app:layout_constraintTop_toTopOf="@+id/headerBackground"
        app:layout_constraintVertical_bias="0.466"
        app:srcCompat="@drawable/sol"
        app:tint="#FFFFFF" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvFotoPerfil"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivFotoPerfil2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Foto de Perfil"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/fotoperfil" />
    </androidx.cardview.widget.CardView>

    <!-- Botão Modo Noturno (Sol / Lua) -->

    <!-- Título da Tela -->


    <!-- Card de Conteúdo da Lista -->

    <TextView
        android:id="@+id/tvCandi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Candidatos"
        android:textColor="#1F4273"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBackground" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvContainerList"
        android:layout_width="352dp"
        android:layout_height="481dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="45dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCandi">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvListaResposta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            tools:listitem="@android:layout/simple_list_item_1" />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvDuvida4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:elevation="16dp"
        android:translationZ="16dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Ícone indicando Ajuda/Info -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="8dp"
                    app:tint="#4CAF50" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:padding="12dp"
                    android:text="@string/titulo_ajuda"
                    android:textColor="#FEBE11"
                    android:textSize="31sp" />

            </LinearLayout>

            <!-- Texto Centralizado -->
            <TextView
                android:id="@+id/tvExibido4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:padding="32dp"
                android:text="@string/texto_candidatos"
                android:textColor="#212121"
                android:textSize="18sp" />

            <!-- Botão "Entendi" Centralizado -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btEntendi4"
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="-6dp"
                android:layout_marginBottom="26dp"
                android:clickable="true"
                android:text="Entendi"
                android:textColor="#FFFFFF"
                android:textSize="18dp"
                app:backgroundTint="#4CAF50"
                app:cornerRadius="20dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <SearchView
        android:id="@+id/svBusca"
        android:layout_width="347dp"
        android:layout_height="47dp"
        android:layout_marginTop="8dp"
        android:iconifiedByDefault="false"
        android:queryHint="Pesquisar..."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCandi" />

</androidx.constraintlayout.widget.ConstraintLayout>