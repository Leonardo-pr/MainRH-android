<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_rounded_dialog">

    <!-- Cabeçalho com Título e Botão Fechar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minha Conta"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1B2430" />

        <ImageButton
            android:id="@+id/btnFecharPerfil"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#1B2430" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <!-- Seção de Identificação do Usuário (Estilo Banco) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/fotoperfil"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomePerfilModal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recrutador"
                android:textColor="#1B2430"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sessão ativa • MainRH"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="#E0E0E0" />

    <!-- Opções do Menu de Perfil (Em lista vertical) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Opção: Dados da Conta -->
        <TextView
            android:id="@+id/optionDadosConta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:text="  Meus Dados"
            android:textColor="#1B2430"
            android:textSize="15sp"
            android:drawableStart="@android:drawable/ic_menu_my_calendar"
            android:drawablePadding="12dp" />

        <!-- Opção: Sair do Aplicativo (Destacado em vermelho suave) -->
        <TextView
            android:id="@+id/optionSair"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:text="  Sair do Aplicativo"
            android:textColor="#EF4444"
            android:textSize="15sp"
            android:textStyle="bold"
            android:drawableStart="@android:drawable/ic_lock_power_off"
            android:drawablePadding="12dp" />
    </LinearLayout>

</LinearLayout>