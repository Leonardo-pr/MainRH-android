<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E2E2E2"
    tools:context=".informacao_candidato">

    <!-- Header Superior -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvHeader"
        android:layout_width="0dp"
        android:layout_height="90dp"
        app:cardBackgroundColor="#203652"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ícone de Perfil Recrutador -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvFotoPerfil"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivFotoPerfil2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Foto de Perfil Recrutador"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/fotoperfil" />
    </androidx.cardview.widget.CardView>

    <!-- Foto do Candidato Centralizada -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvPerfilCandidato"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="45dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvHeader">

        <ImageView
            android:id="@+id/imgFotoCandidato"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Foto Candidato"
            app:srcCompat="@android:drawable/ic_menu_camera" />
    </androidx.cardview.widget.CardView>

    <!-- Nome do Candidato -->
    <TextView
        android:id="@+id/tvNomeCandidatoDetalhe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Nome do Candidato"
        android:textColor="#203652"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvPerfilCandidato" />

    <!-- Card Principal para Exibição da Questão -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvContainerList"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNomeCandidatoDetalhe">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Contador de questões -->
            <TextView
                android:id="@+id/tvContadorQuestao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Questão 1 de 3"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Enunciado da Pergunta -->
            <TextView
                android:id="@+id/tvEnunciado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enunciado da questão vai aparecer aqui..."
                android:textColor="#203652"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#E0E0E0" />

            <!-- Resposta Dada pelo Candidato -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvResposta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resposta do candidato..."
                    android:textColor="#4A4A4A"
                    android:textSize="14sp" />
            </ScrollView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Área de Navegação e Avaliação (Setas + Estrelas) -->
    <LinearLayout
        android:id="@+id/llAreaAvaliacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvContainerList">

        <!-- Seta Anterior -->
        <ImageButton
            android:id="@+id/btnAnterior"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Anterior"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#203652" />

        <!-- Container Vertical para Nota + Estrelas -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Nota Numérica Acima das Estrelas -->
            <TextView
                android:id="@+id/tvNotaNumerica"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="0.0"
                android:textColor="#D32F2F"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- RatingBar -->
            <RatingBar
                android:id="@+id/rbNotaCandidato"
                style="?android:attr/ratingBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="0.5" />
        </LinearLayout>

        <!-- Seta Próxima -->
        <ImageButton
            android:id="@+id/btnProximo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Próximo"
            android:src="@android:drawable/ic_media_next"
            app:tint="#203652" />
    </LinearLayout>

    <!-- Botão de Confirmar e Enviar -->
    <Button
        android:id="@+id/btEnviar"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#48B393"
        android:text="Enviar Avaliação"
        android:textColor="@color/white"
        app:cornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llAreaAvaliacao" />

    <!-- Card de Ajuda Pop-up -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvDuvida5"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/fbInterrogacao5"
        app:layout_constraintEnd_toStartOf="@+id/fbInterrogacao5">

        <TextView
            android:id="@+id/tvExibido5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Avaliação do Candidato:\n\nNavegue entre as questões usando as setas.\nAtribua uma nota para cada resposta de 1 a 5 estrelas.\nO botão 'Enviar Avaliação' será liberado quando todas as questões possuírem nota."
            android:textColor="#203652"
            android:textSize="13sp" />
    </androidx.cardview.widget.CardView>

    <!-- Floating Action Button da Ajuda -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fbInterrogacao5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:alpha="0.8"
        android:clickable="true"
        android:focusable="true"
        app:backgroundTint="#FFFFFF"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/interrogacao"
        app:tint="@color/black" />

</androidx.constraintlayout.widget.ConstraintLayout>